# ── The Perfume Lab · environment configuration ──────────────────────────────
# Copy this file to `.env.local` (dev) or set these in your host (prod).

# MongoDB connection string. When set, all content (products, promotions,
# settings, uploaded images) is stored in MongoDB.
# When omitted, the app runs on a self-contained file-based store at ./.data
# (perfect for local demo, zero setup).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/perfumelab?retryWrites=true&w=majority

# First-run administrator account (seeded once, then changeable in Settings).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=PerfumeLab@2026

# Secret used to sign admin session cookies. MUST be changed in production.
SESSION_SECRET=change-me-to-a-long-random-string

# WhatsApp number that receives orders (digits only, with country code).
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Currency shown across the storefront (also editable in Admin → Settings).
NEXT_PUBLIC_CURRENCY=PKR

# Optional: where the fallback file store keeps its data.
# DATA_DIR=./.data
